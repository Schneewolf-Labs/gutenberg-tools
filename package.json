{
  "name": "gutenberg-tools",
  "version": "1.0.0",
  "description": "A collection of scripts used to make the gutenberg2-dpo dataset from Project Gutenberg books",
  "type": "module",
  "main": "pipeline.js",
  "scripts": {
    "start": "node pipeline.js",
    "clean": "node clean-text.js",
    "deliner": "node deliner.js",
    "summarize": "node summarizer.js",
    "prompt": "node prompter.js",
    "reject": "node rejecter.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage"
  },
  "keywords": [
    "gutenberg",
    "dataset",
    "dpo",
    "nlp",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
